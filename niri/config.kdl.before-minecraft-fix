// options
input {
    keyboard {
        xkb {
            options "caps:escape"
        }
        numlock
    }

    touchpad {
        tap
        dwt
    }

}
xwayland-satellite {
  off
}
hotkey-overlay {
    skip-at-startup
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// monitor
output "eDP-1" {
    scale 2.5
    transform "normal"
}

// look
layout {
    gaps 0
    
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }

    border {
        width 2
    }

}
animations {
    off
}
prefer-no-csd

// rules
workspace "1" {
    layout {
        default-column-width { proportion 1.0; }
        border {
            off
        }
    }
}
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
    match app-id="yazi-chooser"
    open-floating true
    border {
        on
        width 2
    }
}
window-rule {
    match app-id="^foot-run$"
    open-floating true
    border {
        on
        width 2
    }
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

// startup
spawn-at-startup "pipewire"
spawn-at-startup "waybar"
spawn-sh-at-startup "swaybg -i ~/.config/niri/wall.jpg -m fill"
spawn-at-startup "swayidle" "-w"
spawn-at-startup "mako"

// binds
binds {
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn-sh "if tmux display-message -p -t code '#{session_attached}' 2>/dev/null | grep -q '^[1-9]'; then foot; else foot -e tmux new-session -A -s code; fi"; }
    Mod+B hotkey-overlay-title="Open Chromium" { spawn "chromium"; }
    Mod+Space { spawn-sh "menew"; }
    Mod+P { spawn "hyprpicker" "-a"; }
    Print { screenshot; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/dante/.config/niri/volume-osd.sh" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/dante/.config/niri/volume-osd.sh" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "/home/dante/.config/niri/volume-osd.sh" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/home/dante/.config/niri/brightness-osd.sh" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/dante/.config/niri/brightness-osd.sh" "down"; }
    Mod+Q repeat=false { close-window; }
    Alt+Q {quit;}
    alt+shift+left  { focus-monitor-left; }
    alt+shift+down  { focus-monitor-down; }
    alt+shift+up    { focus-monitor-up; }
    alt+shift+right { focus-monitor-right; }
    alt+shift+h     { focus-monitor-left; }
    alt+shift+j     { focus-monitor-down; }
    alt+shift+k     { focus-monitor-up; }
    alt+shift+l     { focus-monitor-right; }
    alt+1 { focus-workspace 1; }
    alt+2 { focus-workspace 2; }
    alt+3 { focus-workspace 3; }
    alt+4 { focus-workspace 4; }
    alt+5 { focus-workspace 5; }
    alt+6 { focus-workspace 6; }
    alt+7 { focus-workspace 7; }
    alt+8 { focus-workspace 8; }
    alt+9 { focus-workspace 9; }
    alt+shift+1 { move-column-to-workspace 1; }
    alt+shift+2 { move-column-to-workspace 2; }
    alt+shift+3 { move-column-to-workspace 3; }
    alt+shift+4 { move-column-to-workspace 4; }
    alt+shift+5 { move-column-to-workspace 5; }
    alt+shift+6 { move-column-to-workspace 6; }
    alt+shift+7 { move-column-to-workspace 7; }
    alt+shift+8 { move-column-to-workspace 8; }
    alt+shift+9 { move-column-to-workspace 9; }
    alt+m { maximize-window-to-edges; }
    Alt+Ctrl+F { expand-column-to-available-width; }
    Alt+Minus { set-column-width "-10%"; }
    Alt+Equal { set-column-width "+10%"; }
    Alt+Shift+Minus { set-window-height "-10%"; }
    Alt+Shift+Equal { set-window-height "+10%"; }
    Super+Shift+1 { spawn "~/.config/niri/focus-by-order.py" "1"; }
    Super+Shift+2 { spawn "~/.config/niri/focus-by-order.py" "2"; }
    Super+Shift+3 { spawn "~/.config/niri/focus-by-order.py" "3"; }
    Super+Shift+4 { spawn "~/.config/niri/focus-by-order.py" "4"; }
    Super+Shift+5 { spawn "~/.config/niri/focus-by-order.py" "5"; }
    Super+Shift+6 { spawn "~/.config/niri/focus-by-order.py" "6"; }
    Super+Shift+7 { spawn "~/.config/niri/focus-by-order.py" "7"; }
    Super+Shift+8 { spawn "~/.config/niri/focus-by-order.py" "8"; }
    Super+Shift+9 { spawn "~/.config/niri/focus-by-order.py" "9"; }
}

include "noctalia.kdl"

