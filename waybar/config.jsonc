{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "spacing": 0,
  "height": 26,
  "modules-left": ["wlr/taskbar"],
  "modules-center": ["clock", "custom/caffeinate", "custom/screenrecording-indicator"],
  "modules-right": [
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "battery"
  ],
"wlr/taskbar": {
    "format": "app:{app_id}",
    "rewrite": {
      ".*([Aa]lacritty|[Ff]oot|[Kk]itty|[Gg]hostty|[Tt]erminal|[Ww]ezterm).*": "",
      ".*([Cc]hromium|[Cc]hrome|[Bb]rave).*": "",
      ".*([Cc]ode|[Cc]odium|[Cc]ursor).*": "",
      ".*([Dd]iscord|[Vv]esktop).*": "",
      ".*([Ff]irefox|[Ll]ibrewolf|[Zz]en).*": "",
      ".*([Nn]autilus|[Tt]hunar|[Dd]olphin|[Yy]azi).*": "",
      ".*([Nn]vim|[Nn]eovim|[Vv]im).*": "",
      ".*([Oo]bsidian).*": "",
      ".*([Ss]potify).*": "",
      ".*([Ss]team).*": "",
      ".*([Tt]elegram).*": "",
      "^app:.*$": ""
    },
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
},
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "on-click": "system-settings",
    "on-click-right": "alacritty"
  },
  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip": false
  },
  "custom/caffeinate": {
    "exec": "$HOME/scripts/caffeinate status",
    "on-click": "$HOME/scripts/caffeinate toggle",
    "return-type": "json",
    "interval": 2,
    "format": "{text} "
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "wifi-settings"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "omarchy-launch-bluetooth"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "audio-settings",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "custom/screenrecording-indicator": {
    "on-click": "$HOME/scripts/record",
    "exec": "$HOME/scripts/record-indicator",
    "interval": 1,
    "signal": 8,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17
  }
}
